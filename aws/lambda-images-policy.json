{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndWriteImages",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::multi-clip-images-433490647961/images/*"
    },
    {
      "Sid": "TellMissingImagesFromForbidden",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::multi-clip-images-433490647961"
    }
  ]
}
